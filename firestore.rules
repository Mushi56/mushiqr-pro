rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Security Helper Functions ────────────────────────────────────
    function isAuth() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function hasRole(r) {
      return isAuth() && 
             request.auth.token != null && 
             request.auth.token.get('role', '') == r;
    }

    function isSuperAdmin() {
      return hasRole('super_admin') || 
             (isAuth() && (request.auth.token.email == 'mabuneri143@gmail.com' || request.auth.token.email == 'mabuneri143@gamil.com'));
    }

    function isAdmin() {
      return hasRole('admin') || isSuperAdmin();
    }

    function isSupport() {
      return hasRole('support') || isAdmin();
    }

    function isEditor() {
      return hasRole('editor') || isAdmin();
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function containsProtectedFields() {
      return request.resource != null && 
             request.resource.data != null && 
             request.resource.data.keys().hasAny(['role', 'isAdmin', 'subscription', 'plan', 'entitlement', 'isPro', 'permissions', 'admin']);
    }

    function containsAppUserProtectedFields() {
      return request.resource != null && 
             request.resource.data != null && 
             request.resource.data.keys().hasAny(['role', 'isPro', 'planId', 'subscriptionStatus', 'entitlement', 'permissions', 'admin', 'roleUpdatedAt', 'roleUpdatedBy', 'proGrantedAt', 'proGrantedBy']);
    }

    // ── Global Config (appSettings, featureFlags, announcement, remoteConfig, membership)
    // Public READ so mobile apps/visitors receive configuration immediately, super-admin WRITE
    match /global_config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Feature Flags Collection
    match /featureFlags/{flagId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Global Templates
    // Public READ so all users can view template catalog, super-admin WRITE/DELETE
    match /global_templates/{docId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // ── Audit Logs
    // Only super-admin can read; write is disabled for clients (Cloud Functions / Admin SDK write only)
    match /global_audit_logs/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── Per-User Data
    // Each user can read/write strictly their own sub-documents (excluding protected security attributes)
    match /users/{userId}/{document=**} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update: if isOwner(userId) && !containsProtectedFields();
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // ── App Users (profile tracking for admin visibility)
    // Users can update non-privileged profile fields; Super Admin manages all fields
    match /app_users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() || (isOwner(userId) && !containsAppUserProtectedFields());
      allow update: if isSuperAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPro', 'planId', 'subscriptionStatus', 'entitlement', 'permissions', 'admin', 'roleUpdatedAt', 'roleUpdatedBy', 'proGrantedAt', 'proGrantedBy']));
      allow delete: if isSuperAdmin();
    }

    // ── App Visitors (anonymous device tracking)
    // Any visitor can register a device; updates are restricted to visitor telemetry attributes
    match /app_visitors/{deviceId} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create: if true;
      allow update: if isSuperAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastVisitAt', 'visitCount', 'linkedUid', 'updatedAt', 'deviceInfo', 'userAgent', 'platform']);
    }

    // ── Subscription Plan Configurations
    // Public READ for plan tiers, super-admin WRITE
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Authoritative User Subscriptions
    // Users can read ONLY their own subscription; write is strictly disabled for ALL clients (Cloud Functions & Admin SDK only)
    match /user_subscriptions/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow write: if false;
    }

    // ── Payment Transactions (Ledger)
    // Only Super Admin can read ledger; write is disabled for clients (Cloud Functions only)
    match /payment_transactions/{transactionId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── Purchase Token Global Registry (Anti-Replay & Concurrency Lock)
    // Client write is strictly disabled (Cloud Functions Admin SDK only)
    match /play_purchase_tokens/{tokenHash} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Default deny all other document matches
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
